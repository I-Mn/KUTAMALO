<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="controller.LoginController" stylesheets="@style.css" styleClass="root-pane" prefWidth="1280" prefHeight="800">
    <center>
        <VBox alignment="CENTER" spacing="30">
            <padding>
                <Insets top="50" right="50" bottom="50" left="50" />
            </padding>
            <VBox alignment="CENTER" spacing="10">
                <ImageView fitHeight="100" preserveRatio="true">
                    <image>
                        <Image url="@images/logo.png" />
                    </image>
                </ImageView>
            </VBox>

            <StackPane>
                <!-- LOGIN FORM -->
                <VBox fx:id="loginForm" styleClass="card-dark" maxWidth="400" spacing="20">
                    <padding>
                        <Insets top="30" right="30" bottom="30" left="30" />
                    </padding>
                    
                    <VBox alignment="CENTER" spacing="5">
                        <Label text="Sign In" styleClass="page-title" />
                        <Label text="Welcome back! Please enter your details." styleClass="text-muted" />
                    </VBox>

                    <Label fx:id="loginErrorLabel" textFill="#ff4c4c" visible="false" managed="false" wrapText="true" />
                    
                    <VBox spacing="10">
                        <Label text="Username" styleClass="card-subtitle-light" />
                        <TextField fx:id="loginUsernameField" styleClass="modal-input" promptText="Enter your username" />
                    </VBox>
                    
                    <VBox spacing="10">
                        <Label text="Password" styleClass="card-subtitle-light" />
                        <PasswordField fx:id="loginPasswordField" styleClass="modal-input" promptText="Enter your password" />
                    </VBox>
                    
                    <Button text="Login" onAction="#handleLogin" styleClass="btn-action" maxWidth="Infinity" />
                    
                    <HBox alignment="CENTER" spacing="5">
                        <Label text="Don't have an account?" styleClass="text-muted" />
                        <Label text="Register" style="-fx-text-fill: #F1C40F; -fx-cursor: hand; -fx-font-weight: bold;" onMouseClicked="#toggleToRegister" />
                    </HBox>
                </VBox>

                <!-- REGISTER FORM -->
                <VBox fx:id="registerForm" styleClass="card-dark" maxWidth="400" spacing="20" visible="false">
                    <padding>
                        <Insets top="30" right="30" bottom="30" left="30" />
                    </padding>
                    
                    <VBox alignment="CENTER" spacing="5">
                        <Label text="Create Account" styleClass="page-title" />
                        <Label text="Join KUTAMALO to track your expenses." styleClass="text-muted" />
                    </VBox>

                    <Label fx:id="registerErrorLabel" textFill="#ff4c4c" visible="false" managed="false" wrapText="true" />
                    
                    <VBox spacing="10">
                        <Label text="Choose Username" styleClass="card-subtitle-light" />
                        <TextField fx:id="registerUsernameField" styleClass="modal-input" promptText="Enter a username" />
                    </VBox>
                    
                    <VBox spacing="10">
                        <Label text="Choose Password" styleClass="card-subtitle-light" />
                        <PasswordField fx:id="registerPasswordField" styleClass="modal-input" promptText="Enter a password" />
                    </VBox>
                    
                    <VBox spacing="10">
                        <Label text="Email Address" styleClass="card-subtitle-light" />
                        <TextField fx:id="registerEmailField" styleClass="modal-input" promptText="Enter your email" />
                    </VBox>
                    
                    <VBox spacing="10">
                        <Label text="Phone Number" styleClass="card-subtitle-light" />
                        <TextField fx:id="registerPhoneField" styleClass="modal-input" promptText="Enter your phone" />
                    </VBox>
                    
                    <Button text="Register Account" onAction="#handleRegister" styleClass="btn-action" maxWidth="Infinity" />
                    
                    <HBox alignment="CENTER" spacing="5">
                        <Label text="Already have an account?" styleClass="text-muted" />
                        <Label text="Sign In" style="-fx-text-fill: #F1C40F; -fx-cursor: hand; -fx-font-weight: bold;" onMouseClicked="#toggleToLogin" />
                    </HBox>
                </VBox>
            </StackPane>
        </VBox>
    </center>
</BorderPane>
