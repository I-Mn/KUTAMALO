<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.AreaChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.MainController" stylesheets="@style.css" styleClass="root-pane" prefWidth="1280" prefHeight="800">
    
    <!-- LAYER 0: MAIN DASHBOARD -->
    <BorderPane>
        <!-- SIDEBAR -->
        <left>
            <VBox styleClass="sidebar" prefWidth="270" alignment="TOP_LEFT" spacing="10">
                <padding>
                    <Insets top="30" right="20" bottom="30" left="20" />
                </padding>
                
                <!-- Brand Logo -->
                <HBox alignment="CENTER_LEFT" spacing="15" styleClass="brand-box">
                    <padding>
                        <Insets bottom="30" />
                    </padding>
                    <ImageView fitHeight="38" preserveRatio="true">
                        <image>
                            <Image url="@images/logo.png" />
                        </image>
                    </ImageView>
                </HBox>
                
                <!-- Nav Items -->
                <HBox fx:id="navHome" onMouseClicked="#navToHome" styleClass="nav-item, nav-active" alignment="CENTER_LEFT" spacing="15">
                    <SVGPath content="m2 10l9.108-7.19a1.44 1.44 0 0 1 1.784 0L16.5 5.658V4a1 1 0 0 1 1-1h1a1 1 0 0 1 1 1v4.026L22 10m-2 1.5v4c0 2.828 0 4.243-.879 5.121c-.878.879-2.293.879-5.121.879h-4c-2.828 0-4.243 0-5.121-.879C4 19.743 4 18.328 4 15.5v-4 M15.001 15.5c-.8.622-1.85 1-3 1s-2.2-.378-3-1" 
         styleClass="nav-icon, nav-icon-active" 
         style="-fx-fill: transparent; -fx-stroke: #FFC107; -fx-stroke-width: 1.5; -fx-stroke-line-cap: round; -fx-stroke-line-join: round;" />

                    <Label text="Home" styleClass="nav-label, nav-label-active" />
                </HBox>

                <HBox fx:id="navAnalytics" onMouseClicked="#navToAnalytics" styleClass="nav-item" alignment="CENTER_LEFT" spacing="15">
                    <SVGPath content="M6.5 17.5v-3m5 3v-9m5 9v-4 M21.5 5.5a3 3 0 1 1-6 0a3 3 0 0 1 6 0Z M21.496 11s.004.34.004 1c0 4.478 0 6.718-1.391 8.109S16.479 21.5 12 21.5c-4.478 0-6.718 0-8.109-1.391S2.5 16.479 2.5 12c0-4.478 0-6.717 1.391-8.109C5.282 2.5 7.521 2.5 12 2.5h1" 
         styleClass="nav-icon" 
         style="-fx-fill: transparent; -fx-stroke: #cccccc; -fx-stroke-width: 1.5; -fx-stroke-line-cap: round; -fx-stroke-line-join: round;" />
                    <Label text="Analytics" styleClass="nav-label" />
                </HBox>


                
                <Region VBox.vgrow="ALWAYS" />
                
                <!-- Bottom Profile -->
                <HBox fx:id="navProfile" onMouseClicked="#navToProfile" styleClass="nav-item" alignment="CENTER_LEFT" spacing="15">
                    <SVGPath content="M11.5 2.5h1c4.243 0 6.364 0 7.682 1.318S21.5 7.258 21.5 11.5v1c0 4.243 0 6.364-1.318 7.682S16.742 21.5 12.5 21.5h-1c-4.243 0-6.364 0-7.682-1.318S2.5 16.742 2.5 12.5v-1c0-4.243 0-6.364 1.318-7.682S7.258 2.5 11.5 2.5 M12 7.395a3.5 3.5 0 1 1 0 7a3.5 3.5 0 0 1 0-7 M18.982 20.895a7 7 0 0 0-13.965 0" 
         styleClass="nav-icon" 
         style="-fx-fill: transparent; -fx-stroke: #cccccc; -fx-stroke-width: 1.5; -fx-stroke-line-cap: round; -fx-stroke-line-join: round;" />
                    <Label text="Profile" styleClass="nav-label" />
                </HBox>

                <HBox fx:id="navSettings" onMouseClicked="#navToSettings" styleClass="nav-item" alignment="CENTER_LEFT" spacing="15">
                    <SVGPath content="m21.318 7.141l-.494-.856c-.373-.648-.56-.972-.878-1.101c-.317-.13-.676-.027-1.395.176l-1.22.344c-.459.106-.94.046-1.358-.17l-.337-.194a2 2 0 0 1-.788-.967l-.334-.998c-.22-.66-.33-.99-.591-1.178c-.261-.19-.609-.19-1.303-.19h-1.115c-.694 0-1.041 0-1.303.19c-.261.188-.37.518-.59 1.178l-.334.998a2 2 0 0 1-.789.967l-.337.195c-.418.215-.9.275-1.358.17l-1.22-.345c-.719-.203-1.078-.305-1.395-.176c-.318.129-.505.453-.878 1.1l-.493.857c-.35.608-.525.911-.491 1.234c.034.324.268.584.736 1.105l1.031 1.153c.252.319.431.875.431 1.375s-.179 1.056-.43 1.375l-1.032 1.152c-.468.521-.702.782-.736 1.105s.14.627.49 1.234l.494.857c.373.647.56.971.878 1.1s.676.028 1.395-.176l1.22-.344a2 2 0 0 1 1.359.17l.336.194c.36.23.636.57.788.968l.334.997c.22.66.33.99.591 1.18c.262.188.609.188 1.303.188h1.115c.694 0 1.042 0 1.303-.189s.371-.519.59-1.179l.335-.997c.152-.399.428-.738.788-.968l.336-.194c.42-.215.9-.276 1.36-.17l1.22.344c.718.204 1.077.306 1.394.177c.318-.13.505-.454.878-1.101l.493-.857c.35-.607.525-.91.491-1.234s-.268-.584-.736-1.105l-1.031-1.152c-.252-.32-.431-.875-.431-1.375s.179-1.056.43-1.375l1.032-1.153c.468-.52.702-.781.736-1.105s-.14-.626-.49-1.234Z M15.52 12a3.5 3.5 0 1 1-7 0a3.5 3.5 0 0 1 7 0Z" 
         styleClass="nav-icon" 
         style="-fx-fill: transparent; -fx-stroke: #cccccc; -fx-stroke-width: 1.5; -fx-stroke-line-cap: round; -fx-stroke-line-join: round;" />
                    <Label text="Settings" styleClass="nav-label" />
                </HBox>

                <HBox fx:id="navLogout" onMouseClicked="#logout" styleClass="nav-item" alignment="CENTER_LEFT" spacing="15">
                    <SVGPath content="M4.393 4C4 4.617 4 5.413 4 7.004v9.994c0 1.591 0 2.387.393 3.002q.105.165.235.312c.483.546 1.249.765 2.78 1.202c1.533.438 2.3.657 2.856.329a1.5 1.5 0 0 0 .267-.202C11 21.196 11 20.4 11 18.803V5.197c0-1.596 0-2.393-.469-2.837a1.5 1.5 0 0 0-.267-.202c-.555-.328-1.323-.11-2.857.329c-1.53.437-2.296.656-2.78 1.202a2.5 2.5 0 0 0-.234.312M11 4h2.017c1.902 0 2.853 0 3.443.586c.33.326.476.764.54 1.414m-6 14h2.017c1.902 0 2.853 0 3.443-.586c.33-.326.476-.764.54-1.414m4-6h-7m5.5-2.5S22 11.34 22 12s-2.5 2.5-2.5 2.5" 
         styleClass="nav-icon" 
         style="-fx-fill: transparent; -fx-stroke: #FF416C; -fx-stroke-width: 1.5; -fx-stroke-line-cap: round; -fx-stroke-line-join: round;" />
                    <Label text="Logout" styleClass="nav-label" style="-fx-text-fill: #FF416C;" />
                </HBox>
            </VBox>
        </left>

        <!-- CONTENT AREA (ROUTING) -->
        <center>
            <StackPane fx:id="contentArea">
                
                <!-- VIEW 1: HOME DASHBOARD -->
                <ScrollPane fx:id="homeView" fitToWidth="true" styleClass="main-scroll">
                    <VBox spacing="40">
                        <padding>
                            <Insets top="50" right="60" bottom="50" left="60" />
                        </padding>
                        
                        <!-- HEADER -->
                        <HBox alignment="CENTER_LEFT">
                            <VBox spacing="5">
                                <Label fx:id="greetingLabel" text="Home" styleClass="page-title" />
                                <Label fx:id="exchangeRateLabel" text="Fetching exchange rate..." styleClass="text-muted" />
                            </VBox>
                            <Region HBox.hgrow="ALWAYS" />
                            <Button text="Add Transaction" onAction="#bukaFormTransaksi" styleClass="btn-action" />
                        </HBox>

                        <!-- 2 COLUMN LAYOUT -->
                        <HBox spacing="50">
                            <!-- LEFT COLUMN -->
                            <VBox spacing="40" HBox.hgrow="ALWAYS" prefWidth="500">
                                <!-- Cards -->
                                <HBox spacing="25">
                                    <!-- Total Balance (Gradient) -->
                                    <VBox fx:id="homeTotalBalanceCard" styleClass="balance-card, card-gradient" HBox.hgrow="ALWAYS">
                                        <HBox alignment="CENTER_LEFT">
                                            <Label fx:id="homeTotalBalanceTitle" text="Total balance" styleClass="card-subtitle-dark" />
                                            <Region HBox.hgrow="ALWAYS" />
                                            <Label fx:id="homeTotalBalancePill" text="Active" styleClass="pill-dark" />
                                        </HBox>
                                        <Region VBox.vgrow="ALWAYS" minHeight="15"/>
                                        <Label fx:id="saldoLabel" text="Rp0" styleClass="card-title-dark" />
                                    </VBox>
                                    
                                    <!-- Pengeluaran (Dark) -->
                                    <VBox styleClass="balance-card, card-dark" HBox.hgrow="ALWAYS">
                                        <HBox alignment="CENTER_LEFT">
                                            <Label text="Savings Plan" styleClass="card-subtitle-light" />
                                            <Region HBox.hgrow="ALWAYS" />
                                            <Label text="Safe" styleClass="pill-light" />
                                        </HBox>
                                        <Region VBox.vgrow="ALWAYS" minHeight="15"/>
                                        <Label fx:id="pengeluaranLabel" text="Rp0" styleClass="card-title-light" />
                                    </VBox>
                                </HBox>

                                <!-- Chart Section -->
                                <VBox styleClass="chart-container" VBox.vgrow="ALWAYS">
                                    <HBox alignment="CENTER_LEFT">
                                        <Label text="Spending" styleClass="section-title" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <HBox alignment="CENTER_RIGHT" spacing="10">
                                                <DatePicker fx:id="startDateFilter" promptText="Start Date" styleClass="chart-date-picker" visible="false" managed="false" onAction="#handleChartFilterChange" />
                                                <DatePicker fx:id="endDateFilter" promptText="End Date" styleClass="chart-date-picker" visible="false" managed="false" onAction="#handleChartFilterChange" />
                                                <ComboBox fx:id="chartDateFilter" styleClass="chart-filter" onAction="#handleChartFilterChange" />
                                            </HBox>
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" spacing="20">
                                        <VBox>
                                            <Label text="Total Income" styleClass="text-muted" />
                                            <Label fx:id="pemasukanLabel" text="Rp0" styleClass="chart-total-label" />
                                        </VBox>
                                    </HBox>
                                    <BarChart fx:id="spendingChart" legendVisible="false" verticalGridLinesVisible="false" horizontalGridLinesVisible="true" styleClass="modern-chart" minHeight="300">
                                        <xAxis>
                                            <CategoryAxis side="BOTTOM" />
                                        </xAxis>
                                        <yAxis>
                                            <NumberAxis side="LEFT" />
                                        </yAxis>
                                    </BarChart>
                                </VBox>
                            </VBox>

                            <!-- RIGHT COLUMN -->
                            <VBox spacing="20" prefWidth="550" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT">
                                    <Label text="Transactions history" styleClass="section-title" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <HBox alignment="CENTER_RIGHT" spacing="15">
                                        <ComboBox fx:id="historyCategoryFilter" styleClass="table-filter" onAction="#handleHistoryFilterChange" />
                                        <HBox styleClass="search-box-container" alignment="CENTER_LEFT" spacing="10">
                                            <SVGPath content="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" fill="#888888"/>
                                            <TextField fx:id="searchTransactionField" promptText="Search for a transaction" styleClass="search-box" />
                                        </HBox>
                                    </HBox>
                                </HBox>
                                <HBox styleClass="list-header" spacing="15">
                                    <Label text="Category" prefWidth="250" />
                                    <Label text="Date" prefWidth="120" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label text="Amount" alignment="CENTER_RIGHT" prefWidth="200" />
                                    <Label text="Action" alignment="CENTER" prefWidth="100" />
                                </HBox>
                                <VBox fx:id="listRiwayat" spacing="0" />
                            </VBox>
                        </HBox>
                    </VBox>
                </ScrollPane>

                <!-- VIEW 2: CARDS EDITOR -->
                <ScrollPane fx:id="cardsView" fitToWidth="true" styleClass="main-scroll" visible="false">
                    <VBox spacing="40">
                        <padding>
                            <Insets top="50" right="60" bottom="50" left="60" />
                        </padding>
                        
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Card Editor" styleClass="page-title" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button text="Save Changes" onAction="#navToHome" styleClass="btn-action" />
                        </HBox>

                        <HBox spacing="80">
                            <!-- Left: Card Preview -->
                            <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
                                <VBox fx:id="previewCard" styleClass="balance-card, card-gradient" prefWidth="500" prefHeight="300" maxWidth="500" maxHeight="300">
                                    <padding>
                                        <Insets top="40" right="40" bottom="40" left="40"/>
                                    </padding>
                                    <HBox alignment="CENTER_LEFT">
                                        <SVGPath content="M20 4H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4v-6h16v6zm0-10H4V6h16v2z" fill="#000000" scaleX="1.5" scaleY="1.5"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14.5v-9l6 4.5-6 4.5z" fill="#000000" scaleX="1.5" scaleY="1.5"/>
                                    </HBox>
                                    <Region VBox.vgrow="ALWAYS" />
                                    <Label fx:id="previewCardTitle" text="Total balance" styleClass="card-subtitle-dark" />
                                    <Label fx:id="previewSaldoLabel" text="Rp0" styleClass="card-title-dark" style="-fx-font-size: 50px;"/>
                                </VBox>
                            </VBox>

                            <!-- Right: Settings -->
                            <VBox spacing="30" prefWidth="400">
                                <VBox spacing="15">
                                    <Label text="Background Colors" styleClass="section-title" />
                                    <Label text="Choose a theme for your primary balance card" styleClass="text-muted" />
                                    
                                    <!-- Color Swatches -->
                                    <HBox spacing="15">
                                        <Button styleClass="color-swatch" style="-fx-background-color: linear-gradient(to bottom right, #468AFF, #00FBFF);" onAction="#setThemeCyan" />
                                        <Button styleClass="color-swatch" style="-fx-background-color: linear-gradient(to bottom right, #00FF7F, #008000);" onAction="#setThemeGreen" />
                                        <Button styleClass="color-swatch" style="-fx-background-color: linear-gradient(to bottom right, #FF416C, #FF4B2B);" onAction="#setThemeRed" />
                                        <Button styleClass="color-swatch" style="-fx-background-color: linear-gradient(to bottom right, #8A2387, #E94057);" onAction="#setThemeSunset" />
                                        <Button styleClass="color-swatch" style="-fx-background-color: #1a1a1a; -fx-border-color: #333333; -fx-border-radius: 12;" onAction="#setThemeDark" />
                                    </HBox>
                                </VBox>

                                <VBox spacing="15">
                                    <Label text="Card Name" styleClass="section-title" />
                                    <TextField fx:id="cardNameField" promptText="e.g. Total balance, My Wallet" styleClass="modal-input" onKeyReleased="#updateCardNamePreview" />
                                </VBox>
                            </VBox>
                        </HBox>
                    </VBox>
                </ScrollPane>

                <!-- VIEW 3: ANALYTICS -->
                <ScrollPane fx:id="analyticsView" fitToWidth="true" styleClass="main-scroll" visible="false">
                    <VBox spacing="40">
                        <padding>
                            <Insets top="50" right="60" bottom="50" left="60" />
                        </padding>
                        
                        <!-- Header & Filters -->
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Analytics Dashboard" styleClass="page-title" />
                            <Region HBox.hgrow="ALWAYS" />
                            <HBox alignment="CENTER_RIGHT" spacing="15">
                                <DatePicker fx:id="analyticsStartPicker" promptText="Start Date" styleClass="chart-date-picker" visible="false" managed="false" />
                                <DatePicker fx:id="analyticsEndPicker" promptText="End Date" styleClass="chart-date-picker" visible="false" managed="false" />
                                <ComboBox fx:id="analyticsDateFilter" promptText="Filter" styleClass="chart-filter" onAction="#handleAnalyticsFilterChange" />
                            </HBox>
                        </HBox>
                        
                        <!-- Key Metrics Cards -->
                        <HBox spacing="30">
                            <!-- Income Card -->
                            <VBox styleClass="balance-card, card-dark" HBox.hgrow="ALWAYS" spacing="10">
                                <Label text="Total Income" styleClass="text-muted" />
                                <Label fx:id="analyticsIncomeLabel" text="Rp0" styleClass="chart-total-label" style="-fx-text-fill: #2ecc71;" />
                            </VBox>
                            
                            <!-- Expense Card -->
                            <VBox styleClass="balance-card, card-dark" HBox.hgrow="ALWAYS" spacing="10">
                                <Label text="Total Expense" styleClass="text-muted" />
                                <Label fx:id="analyticsExpenseLabel" text="Rp0" styleClass="chart-total-label" style="-fx-text-fill: #e74c3c;" />
                            </VBox>
                            
                            <!-- Net Flow Card -->
                            <VBox styleClass="balance-card, card-dark" HBox.hgrow="ALWAYS" spacing="10">
                                <Label text="Net Cash Flow" styleClass="text-muted" />
                                <Label fx:id="analyticsNetFlowLabel" text="Rp0" styleClass="chart-total-label" />
                            </VBox>
                        </HBox>
                        
                        <!-- Trend Chart -->
                        <VBox styleClass="balance-card, card-dark" spacing="20">
                            <Label text="Cash Flow Trend" styleClass="section-title" />
                            <AreaChart fx:id="analyticsTrendChart" prefHeight="350" legendVisible="true" animated="false">
                                <xAxis>
                                    <CategoryAxis side="BOTTOM" />
                                </xAxis>
                                <yAxis>
                                    <NumberAxis side="LEFT" />
                                </yAxis>
                            </AreaChart>
                        </VBox>
                        
                        <!-- Breakdowns -->
                        <HBox spacing="30">
                            <!-- Expense Breakdown -->
                            <VBox styleClass="balance-card, card-dark" HBox.hgrow="ALWAYS" alignment="CENTER" prefHeight="400">
                                <Label text="Expenses Breakdown" styleClass="section-title" />
                                <Region VBox.vgrow="ALWAYS"/>
                                <PieChart fx:id="expensePieChart" legendVisible="true" labelsVisible="true" prefHeight="300" animated="false" />
                            </VBox>
                            
                            <!-- Income Breakdown -->
                            <VBox styleClass="balance-card, card-dark" HBox.hgrow="ALWAYS" alignment="CENTER" prefHeight="400">
                                <Label text="Income Sources" styleClass="section-title" />
                                <Region VBox.vgrow="ALWAYS"/>
                                <PieChart fx:id="analyticsIncomePieChart" legendVisible="true" labelsVisible="true" prefHeight="300" animated="false" />
                            </VBox>
                        </HBox>
                        
                    </VBox>
                </ScrollPane>

                <!-- VIEW 4: PROFILE -->
                <ScrollPane fx:id="profileView" fitToWidth="true" styleClass="main-scroll" visible="false">
                    <VBox spacing="40">
                        <padding>
                            <Insets top="50" right="60" bottom="50" left="60" />
                        </padding>
                        <Label text="My Profile" styleClass="page-title" />
                        
                        <HBox spacing="50">
                            <!-- Left: Profile Info -->
                            <VBox spacing="30" HBox.hgrow="ALWAYS">
                                <VBox spacing="5">
                                    <Label text="Personal Information" styleClass="section-title" />
                                    <Label text="Update your personal details here." styleClass="text-muted" />
                                </VBox>
                                
                                <VBox spacing="30" styleClass="card-dark" style="-fx-padding: 30;">
                                    <!-- Avatar -->
                                    <HBox alignment="CENTER" spacing="30">
                                        <VBox alignment="CENTER" style="-fx-background-color: #2a2a2a; -fx-background-radius: 50%; -fx-min-width: 100; -fx-min-height: 100; -fx-clip: null;">
                                            <!-- Use a StackPane to hold either SVG or Image -->
                                            <StackPane style="-fx-background-radius: 50%; -fx-min-width: 100; -fx-min-height: 100; -fx-max-width: 100; -fx-max-height: 100; -fx-overflow: hidden;">
                                                <SVGPath fx:id="profileAvatarIcon" content="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" fill="#888888" scaleX="3" scaleY="3" />
                                                <ImageView fx:id="profileAvatarImage" fitWidth="100" fitHeight="100" visible="false" />
                                            </StackPane>
                                        </VBox>
                                        <VBox alignment="CENTER_LEFT" spacing="5">
                                            <Label text="Change Avatar" onMouseClicked="#changeAvatar" style="-fx-text-fill: #00FBFF; -fx-cursor: hand; -fx-font-weight: bold;"/>
                                            <Label text="JPEG or PNG, max 2MB" styleClass="text-muted"/>
                                        </VBox>
                                    </HBox>
    
                                    <!-- Form -->
                                    <VBox spacing="20">
                                        <VBox spacing="8">
                                            <Label text="Full Name" styleClass="modal-label" />
                                            <TextField fx:id="profileFullNameField" promptText="Your full name" styleClass="modal-input" />
                                        </VBox>
                                        <VBox spacing="8">
                                            <Label text="Email Address" styleClass="modal-label" />
                                            <TextField fx:id="profileEmailField" promptText="you@example.com" styleClass="modal-input" />
                                        </VBox>
                                        <VBox spacing="8">
                                            <Label text="Phone Number" styleClass="modal-label" />
                                            <TextField fx:id="profilePhoneField" promptText="+62..." styleClass="modal-input" />
                                        </VBox>
                                        
                                        <HBox alignment="CENTER_RIGHT" spacing="15">
                                            <Label fx:id="profileStatusLabel" visible="false" managed="false" wrapText="true" />
                                            <Button text="Save Profile" onAction="#saveProfile" styleClass="btn-primary" />
                                        </HBox>
                                    </VBox>
                                </VBox>
                            </VBox>

                            <!-- Right: Update Password -->
                            <VBox spacing="30" HBox.hgrow="ALWAYS">
                                <VBox spacing="5">
                                    <Label text="Security" styleClass="section-title" />
                                    <Label text="Update your password to keep your account secure." styleClass="text-muted" />
                                </VBox>
                                
                                <VBox spacing="20" styleClass="card-dark" style="-fx-padding: 30;">
                                    <VBox spacing="8">
                                        <Label text="Current Password" styleClass="modal-label" />
                                        <PasswordField fx:id="oldPasswordField" promptText="Enter current password" styleClass="modal-input" />
                                    </VBox>
                                    <VBox spacing="8">
                                        <Label text="New Password" styleClass="modal-label" />
                                        <PasswordField fx:id="newPasswordField" promptText="Enter new password" styleClass="modal-input" />
                                    </VBox>
                                    
                                    <HBox alignment="CENTER_RIGHT" spacing="15">
                                        <Label fx:id="passwordStatusLabel" visible="false" managed="false" wrapText="true" />
                                        <Button text="Update Password" onAction="#updatePassword" style="-fx-background-color: #F1C40F; -fx-text-fill: #121212; -fx-font-weight: bold; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 10 20; -fx-cursor: hand;" />
                                    </HBox>
                                </VBox>
                            </VBox>
                        </HBox>
                    </VBox>
                </ScrollPane>

                <!-- VIEW 5: SETTINGS -->
                <ScrollPane fx:id="settingsView" fitToWidth="true" styleClass="main-scroll" visible="false">
                    <VBox spacing="40">
                        <padding>
                            <Insets top="50" right="60" bottom="50" left="60" />
                        </padding>
                        <Label text="Settings" styleClass="page-title" />
                        
                        <VBox spacing="30" maxWidth="600">
                            <!-- Danger Zone -->
                            <VBox styleClass="balance-card, card-dark" style="-fx-border-color: #FF416C; -fx-border-width: 2;" spacing="20">
                                <Label text="Danger Zone" style="-fx-text-fill: #FF416C; -fx-font-size: 20px; -fx-font-weight: bold;" />
                                <Label text="Deleting all data will permanently wipe your transaction history from the database. This action cannot be undone." style="-fx-text-fill: #cccccc; -fx-wrap-text: true;"/>
                                <Button text="Delete All Data" style="-fx-background-color: transparent; -fx-border-color: #FF416C; -fx-border-radius: 30; -fx-text-fill: #FF416C; -fx-font-size: 15px; -fx-font-weight: bold; -fx-padding: 10 25; -fx-cursor: hand;" onAction="#clearAllData" />
                            </VBox>
                        </VBox>
                    </VBox>
                </ScrollPane>

            </StackPane>
        </center>
    </BorderPane>

    <!-- LAYER 1: MODAL OVERLAY -->
    <StackPane fx:id="modalOverlay" styleClass="modal-overlay" visible="false">
        <VBox styleClass="modal-content" maxWidth="500" maxHeight="600" spacing="25" alignment="CENTER_LEFT">
            <padding>
                <Insets top="40" right="40" bottom="40" left="40" />
            </padding>
            <HBox alignment="CENTER_LEFT">
                <Label text="Add Transaction" styleClass="modal-title" />
                <Region HBox.hgrow="ALWAYS" />
                <Button text="✕" styleClass="btn-close" onAction="#tutupFormTransaksi" />
            </HBox>
            
            <VBox spacing="8">
                <Label text="Type" styleClass="modal-label" />
                <ComboBox fx:id="jenisComboModal" prefWidth="Infinity" minHeight="42" prefHeight="42" styleClass="modal-input" />
            </VBox>
            
            <VBox spacing="8">
                <Label text="Amount" styleClass="modal-label" />
                <TextField fx:id="nominalFieldModal" promptText="0.00" minHeight="42" prefHeight="42" styleClass="modal-input" />
            </VBox>
            
            <VBox spacing="8">
                <Label text="Category" styleClass="modal-label" />
                <ComboBox fx:id="kategoriComboModal" prefWidth="Infinity" minHeight="42" prefHeight="42" styleClass="modal-input" />
            </VBox>
            
            <VBox spacing="8">
                <Label text="Date" styleClass="modal-label" />
                <DatePicker fx:id="tanggalPickerModal" prefWidth="Infinity" minHeight="42" prefHeight="42" styleClass="modal-input" />
            </VBox>

            <VBox spacing="8">
                <Label text="Description" styleClass="modal-label" />
                <TextArea fx:id="deskripsiAreaModal" prefRowCount="3" promptText="Optional notes..." styleClass="modal-input" />
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <HBox spacing="15" alignment="CENTER_RIGHT">
                <Button text="Cancel" styleClass="btn-secondary" onAction="#tutupFormTransaksi" />
                <Button text="Save Transaction" styleClass="btn-primary" onAction="#simpanDariModal" />
            </HBox>
        </VBox>
    </StackPane>

    <!-- LAYER 2: LOGOUT MODAL OVERLAY -->
    <StackPane fx:id="logoutModalOverlay" styleClass="modal-overlay" visible="false">
        <VBox styleClass="modal-content" maxWidth="400" maxHeight="200" spacing="25" alignment="CENTER">
            <padding>
                <Insets top="40" right="40" bottom="40" left="40" />
            </padding>
            <VBox alignment="CENTER" spacing="10">
                <Label text="Logout Confirmation" styleClass="modal-title" />
                <Label text="Are you sure you want to logout?" styleClass="text-muted" />
            </VBox>
            <HBox spacing="15" alignment="CENTER">
                <Button text="Cancel" styleClass="btn-secondary" onAction="#cancelLogout" />
                <Button text="Logout" styleClass="btn-primary" onAction="#confirmLogout" />
            </HBox>
        </VBox>
    </StackPane>

</StackPane>
